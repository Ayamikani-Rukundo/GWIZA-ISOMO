{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "buildCommand": "pnpm run typecheck && pnpm run build",
      "functions": {
        "src/app.ts": {
          "includeFiles": "dist/private-approval.pdf",
          "maxDuration": 30
        }
      }
    },
    "gwiza-research": {
      "root": "artifacts/gwiza-research",
      "framework": "vite",
      "buildCommand": "pnpm run typecheck && pnpm run build",
      "outputDirectory": "dist/public",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api-server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "gwiza-research" }
    }
  ]
}
