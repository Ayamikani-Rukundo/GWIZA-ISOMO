# Use the project root URL, e.g. https://YOUR_PROJECT_REF.supabase.co.
# Do not include /rest/v1/. The secret key is used only by the API server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local API port. The Vite app runs on http://localhost:5173 by default.
API_PORT=3001

# Research administrator sign-in; keep both values private.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Generate a strong random value locally. Never use a development value in production.
SESSION_SECRET=
